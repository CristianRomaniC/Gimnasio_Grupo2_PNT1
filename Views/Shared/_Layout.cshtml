<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>@ViewData["Title"] - GimnasioGrupo2</title>
 <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
 <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
 var controller = Context.Request.RouteValues["controller"]?.ToString();
 var action = Context.Request.RouteValues["action"]?.ToString();
 string bodyClass = "";
 if(controller == "Home" && action == "Index") { bodyClass = "bg-default"; }
 else if(controller == "Clientes" && action == "Index") { bodyClass = "bg-2"; }
 else { bodyClass = ""; }
}
<body class="@bodyClass">
 <header class="mb-4" role="banner">
 <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light" role="navigation">
 <div class="container">
 <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">GimnasioGrupo2</a>

 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="#navbarNav"
 aria-expanded="false" aria-label="Toggle navigation">
 <span class="navbar-toggler-icon"></span>
 </button>

 <div class="collapse navbar-collapse" id="navbarNav">
 <ul class="navbar-nav ms-auto">
 <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Inicio</a></li>
 <li class="nav-item"><a class="nav-link text-white" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
 <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Privacy">Objetos perdidos</a></li>
 </ul>
 </div>
 </div>
 </nav>
 </header>

 <main class="container" role="main">
 @RenderBody()
 </main>

 <footer class="footer text-center" role="contentinfo">
 <div class="container">
 <p class="mb-0">&copy; @DateTime.Now.Year - GimnasioGrupo2</p>
 </div>
 </footer>

 <script src="~/lib/jquery/dist/jquery.min.js"></script>
 <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
 @await RenderSectionAsync("Scripts", required: false)
</body>
</html>