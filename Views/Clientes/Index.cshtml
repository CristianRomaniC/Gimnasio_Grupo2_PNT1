@model IEnumerable<GimnasioGrupo2.Models.Cliente>

@{
 ViewData["Title"] = "Clientes";
}

<div class="page-clients-index">
 <div class="d-flex justify-content-between align-items-center mb-3">
 <h2 class="text-white">Clientes</h2>
 <div>
 <a class="btn btn-action-new btn-lg" asp-action="Create" aria-label="Nuevo Cliente"><span class="icon">➕</span> <span class="label">Nuevo Cliente</span></a>
 </div>
 </div>

 <div class="grid">
 @foreach(var c in Model){
 <div class="card-gym fade-in">
 <div class="d-flex justify-content-between align-items-start">
 <div>
 <h5 class="card-title">@c.Nombre @c.Apellido</h5>
 <div class="card-sub">DNI: @c.Dni · Tel: @c.Telefono</div>
 <div class="mt-2">Objetivo: @c.Objetivo</div>
 </div>
 <div class="text-end">
 <a class="btn-action-view mb-2 d-block" asp-action="Details" asp-route-id="@c.Dni">
 <span class="icon">🔍</span> <span class="label">Ver</span>
 </a>
 <a class="btn-action-edit mb-2 d-block" asp-action="Edit" asp-route-id="@c.Dni">
 <span class="icon">✏️</span> <span class="label">Editar</span>
 </a>
 <form asp-action="Delete" asp-route-id="@c.Dni" method="post" style="display:inline">
 <button class="btn-action-delete" type="submit">
 <span class="icon">🗑️</span> <span class="label">Eliminar</span>
 </button>
 </form>
 </div>
 </div>
 </div>
 }
 </div>
</div>
