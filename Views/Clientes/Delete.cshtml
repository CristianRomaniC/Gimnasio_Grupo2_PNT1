@model GimnasioGrupo2.Models.Cliente

@{
 ViewData["Title"] = "Eliminar Cliente";
}

<div class="page-clients-delete">
 <div class="card-gym p-4 text-center contrast-box">
 <h3>Eliminar Cliente</h3>
 <p class="card-sub mb-3">¿Estás seguro que querés eliminar a <strong>@Model.Nombre @Model.Apellido</strong> (DNI: @Model.Dni)?</p>
 <form asp-action="Delete" method="post">
 @Html.AntiForgeryToken()
 <input type="hidden" asp-for="Dni" />
 <button type="submit" class="btn-action-delete me-2"><span class="icon">🗑️</span> Sí, eliminar</button>
 <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
 </form>
 </div>
</div>
