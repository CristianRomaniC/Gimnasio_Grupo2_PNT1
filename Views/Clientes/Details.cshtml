@model GimnasioGrupo2.Models.Cliente

@{
    ViewData["Title"] = "Detalle Cliente";
}

<div class="page-clients-details">
    <div class="card-gym p-4 fade-in contrast-box">
        <div class="d-flex justify-content-between">
            <div>
                <h3>@Model.Nombre @Model.Apellido</h3>
                <div class="card-sub">DNI: @Model.Dni</div>
            </div>
            <div>
                <a class="btn-action-edit me-2" asp-action="Edit" asp-route-id="@Model.Dni"><span class="icon">✏️</span> Editar</a>
                <form asp-action="Delete" asp-route-id="@Model.Dni" method="post" style="display:inline">
                    <button class="btn-action-delete" type="submit"><span class="icon">🗑️</span> Eliminar</button>
                </form>
            </div>
        </div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Telefono</dt>
            <dd class="col-sm-9">@Model.Telefono</dd>
            <dt class="col-sm-3">Fecha Nac.</dt>
            <dd class="col-sm-9">@Model.FechaNacimiento.ToShortDateString()</dd>
            <dt class="col-sm-3">Objetivo</dt>
            <dd class="col-sm-9">@Model.Objetivo</dd>
        </dl>
        <a asp-action="Index" class="btn btn-outline-light">Volver</a>
    </div>
</div>
