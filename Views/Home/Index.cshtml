@{
    ViewData["Title"] = "Inicio";
}

<div class="page-home">
    <div class="container-fluid p-0">
        <div class="hero bg-dark text-light" style="background-image: linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.55)), url('/images/fondo_user.jpg'); background-size: cover; background-position: center; min-height:72vh;">
            <div class="container h-100 d-flex flex-column justify-content-center align-items-center text-center py-5 hero-inner">
                <div class="contrast-box">
                    <h1 class="display-4 fw-bold">Bienvenido al Sistema de Clientes</h1>
                    
                    <p class="lead text-muted mb-4">Administra clientes, membresías y rutinas con una interfaz moderna.</p>
                    <div>
                        <a class="btn btn-lg btn-primary me-2" asp-controller="Clientes" asp-action="Index">Ver Clientes</a>
                        <a class="btn btn-lg btn-action-new" asp-controller="Clientes" asp-action="Create">Nuevo Cliente</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
